# Copy this to .env and fill in real values
# .env is gitignored — never commit it

# Cloudflare API token (Zone:DNS:Edit, scoped to myhouse.fyi)
CF_API_TOKEN=your_cloudflare_api_token_here

# DeejAI API key — any strong random string, used as Bearer token by the iOS app
# Generate one with: openssl rand -hex 32
DEEJAY_API_KEY=your_api_key_here
